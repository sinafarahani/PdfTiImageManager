APP_NAME="PDF to Image Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (database/database.sqlite) needs no database server. For MySQL set DB_CONNECTION=mysql and the DB_* values.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pdftoimgmanager
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Administrator created by `php artisan db:seed` (a random password is printed when ADMIN_PASSWORD is empty).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- The conversion pipeline (replaces the e{n}.exe workers) ---------------------------------
# The archive database (SQL Server). Needs the pdo_sqlsrv extension; encryption is off because the
# server is reached over the internal network with ODBC Driver 17.
ARCHIVE_DB_HOST=
ARCHIVE_DB_PORT=1433
ARCHIVE_DB_DATABASE=
ARCHIVE_DB_USERNAME=
ARCHIVE_DB_PASSWORD=
ARCHIVE_DB_ENCRYPT=no
ARCHIVE_DB_TRUST_CERTIFICATE=true

# "off" lets the whole pipeline run without changing anything in the archive (a dry run).
# Set it to "on" only when you mean to write.
CONVERTER_WRITE_MODE=off

# Contents converted at the same time: run this many `php artisan queue:work --queue=conversions`.
CONVERTER_WORKERS=4

# pdf2img and its arguments. This is the renderer itself, not the old wrapper from the worker folders.
CONVERTER_PDF2IMG="C:\\pdfToImg\\bin\\pdf2img.exe"
CONVERTER_PDF2IMG_ARGS="-r 300"

# Where a content's PDF and rendered pages live while it is converted; each content's folder is
# deleted as soon as its pages are stored. Conversion pauses while the drive has less than the floor.
CONVERTER_WORKSPACE="C:\\pdfToImg\\work"
CONVERTER_FREE_SPACE_FLOOR_GB=20
