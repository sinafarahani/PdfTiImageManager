# PDF to Image Manager - copy this file to .env and fill it in. This is the only file you edit to
# deploy the panel; nothing under config/ or app/ needs touching.
#
# Windows paths: either leave them unquoted (C:\pdfToImg\work) or quote them and double every
# backslash ("C:\\pdfToImg\\work"). A quoted path with single backslashes ("C:\pdfToImg\work") is an
# invalid escape sequence and every artisan command then refuses to start with "The environment file
# is invalid!".

# --- Application -----------------------------------------------------------------------------
APP_NAME="PDF to Image Manager"
APP_ENV=production
# Left empty on purpose: `php artisan key:generate` fills it in - before `php artisan optimize`, and
# never after it without running `php artisan optimize` again. Livewire derives the address of the
# endpoint the Start and Stop buttons post to from this key, so a cached route table built under the
# previous key leaves a dashboard that renders perfectly and whose buttons do nothing at all, with
# nothing written to any log.
APP_KEY=
APP_DEBUG=false
# How the panel is reached. Used for the links artisan prints and for the assets the pages load.
APP_URL=http://localhost:8000

# The timezone every date is written in, and NOT only a display setting: the converter stamps
# MVDContent.CreateDateTime from it, and that timestamp is also the FTP folder the page images go in
# (<site folder>/yyyy/MM/dd/HH/mm/ss/<id>.jpg). It must be the archive server's own timezone, the one
# SQL Server's `SELECT GETDATE()` returns - otherwise new pages land in a folder tree the archive's
# other tools never look in and their dates read hours apart from every existing row.
APP_TIMEZONE=Asia/Tehran

# Interface language only. Dates are not formatted from it.
APP_LOCALE=en

# --- The panel's own database (MySQL 8.0 or newer) -------------------------------------------
# Holds the users, the work queue, the record of every page written, the sessions, the cache and the
# job queue. Create it empty first: CREATE DATABASE pdftoimgmanager CHARACTER SET utf8mb4;
# MySQL 8.0 is a hard requirement, not a preference: the queue claims work with
# SELECT ... FOR UPDATE SKIP LOCKED, which MySQL 5.7 rejects as a syntax error.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pdftoimgmanager
DB_USERNAME=
DB_PASSWORD=

# --- Session, cache and queue ----------------------------------------------------------------
# All three go in the database above. Keep them there.
#
# CACHE_STORE especially: the cache is where Start/Stop lives, and the panel, the dispatcher, the
# supervisor and every queue worker are separate processes that must agree on it. The "file" store
# would put that state in storage/framework/cache/data, readable only by the Windows account that
# wrote it - the panel usually runs as one account and the supervisor task as another - and a Start
# would then be written and never seen, with nothing logged.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Minutes a signed-in browser stays signed in.
SESSION_LIFETIME=120

# --- Logging ---------------------------------------------------------------------------------
# One file per day, kept for a month: a single file would grow without limit while half a million
# contents convert. "info" logs what the pipeline decided; "debug" adds every query.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# --- The administrator ------------------------------------------------------------------------
# Created by `php artisan db:seed --force`. Leave the password empty and it prints a random one once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- The archive (Papyrus, on SQL Server) -----------------------------------------------------
# The database the contents are read from and the page rows are written to. Needs pdo_sqlsrv and
# Microsoft ODBC Driver 17 or 18. Encryption is off and the certificate is trusted because the server
# is reached over the internal network; both must stay as strings ("no"/"true"), not true/false.
# The FTP site is not configured here - the pipeline reads its host, folder and login from the
# archive's own FtpSites table, so it always uses the site the archive itself marks as current.
ARCHIVE_DB_HOST=
ARCHIVE_DB_PORT=1433
ARCHIVE_DB_DATABASE=papyrus
ARCHIVE_DB_USERNAME=
ARCHIVE_DB_PASSWORD=
ARCHIVE_DB_ENCRYPT=no
ARCHIVE_DB_TRUST_CERTIFICATE=true
# Seconds to wait for the login before giving up.
ARCHIVE_DB_LOGIN_TIMEOUT=5

# --- The converter ----------------------------------------------------------------------------
# When you have finished editing this file, run `php artisan converters:preflight`. It checks every
# value below against this machine, the archive and the FTP site without changing anything, prints
# one line per check, and exits 1 if something has to be fixed before the converters are started.
#
# "off" makes the archive refuse every write, which is what the dry run needs - but it is not a mode
# to convert in. The dry run is `php artisan converters:try <content id>`: that one really downloads
# the PDF and really renders it, and prints the rows and uploads instead of making them.
#
# Do not press Start while this is "off". The first thing a conversion does is take the content in
# the archive, which is a write: every content would fail at its first step, the attempt would be
# counted, and after CONVERTER_MAX_ATTEMPTS attempts the content is left failed in the panel with
# nothing to show for it. Set it to "on" before the converters are started for real.
CONVERTER_WRITE_MODE=off

# Contents converted at the same time, i.e. how many queue workers the supervisor keeps running.
CONVERTER_WORKERS=4

# The renderer and the arguments in front of the input and output paths. "-r 300" is the resolution.
CONVERTER_PDF2IMG="C:\\pdfToImg\\bin\\pdf2img.exe"
CONVERTER_PDF2IMG_ARGS="-r 300"

# Where a content's PDF and its rendered pages live while it is converted. Each content gets its own
# folder and it is deleted as soon as its pages are stored. The folder is created if it is missing.
CONVERTER_WORKSPACE="C:\\pdfToImg\\work"

# Gigabytes that must stay free on that drive. Below it the pipeline pauses instead of filling the
# disk, which is how the old pipeline lost 206 contents.
CONVERTER_FREE_SPACE_FLOOR_GB=20

# Minutes before `converters:sweep` (hourly) deletes a workspace folder that belongs to no conversion
# being converted. Only a conversion killed mid-way leaves one behind; keep it above the time a long
# content takes, so a folder a worker has only just opened is never swept.
CONVERTER_SWEEP_AFTER_MINUTES=60

# Seconds one PDF may take to render before the worker is killed and the content retried. The
# production log has conversions of 205 seconds, so this is deliberately generous.
CONVERTER_RENDER_TIMEOUT=1800

# --- Retrying and recovery --------------------------------------------------------------------
# Attempts per content before it is left failed for somebody to look at.
CONVERTER_MAX_ATTEMPTS=3

# A conversion whose worker stopped reporting for this long is cleaned up and queued again. It must
# stay well clear of CONVERTER_RENDER_TIMEOUT, which is the longest a healthy conversion goes quiet
# for; converters:preflight checks the two against each other.
CONVERTER_STALE_AFTER_MINUTES=90

# Whether anyone who can reach the panel may create an account for themselves. They could only watch
# (starting and stopping needs an administrator), but on an internal tool this is normally off; add
# people with `php artisan db:seed` or from the database instead.
ALLOW_REGISTRATION=false

# --- Finding work -----------------------------------------------------------------------------
# Contents pulled into the queue per pass, and minutes between passes (run by `schedule:run`).
CONVERTER_DISCOVERY_BATCH=5000
CONVERTER_DISCOVERY_INTERVAL=15

# Minutes the ProcessDate watermark is rewound on every pass, so a content inserted while a pass was
# running is not stepped over.
CONVERTER_DISCOVERY_OVERLAP=60

# Profiles that are not converted at all, as a comma-separated list of ProfileID (e.g. 65,71).
# A profile whose documents have been taken off the file store still has all of its contents in the
# archive, each naming a PDF that is not there any more, and nothing in the database says so - so the
# pipeline can only find out by connecting to the FTP site and asking for the file, which takes a
# second or two per content and converts nothing. Naming the profile here answers for all of them at
# once: discovery stops offering it and `converters:skip` (on the schedule) takes the ones already
# queued out of the queue without a single connection. Nothing in the archive is changed, so removing
# a profile from this list and running `php artisan converters:retry --stage=skipped` puts them back.
CONVERTER_SKIP_PROFILES=

# First pass only: take the waiting contents from the old pipeline's PdfConvert table instead of
# scanning GeneralContent, which has ~93 million rows. Set it to false for a clean archive.
CONVERTER_SEED_FROM_PDFCONVERT=true

# --- Reaching the archive's files ---------------------------------------------------------------
# "ftp" talks to the site the archive names in FtpSites; "disk" opens the same folders directly.
#
# Use "disk" when the panel runs on the machine that holds the archive. Over FTP the source PDF is
# copied into the workspace to be rendered; on disk the renderer opens the archive's own file where
# it lies, so a conversion does one fewer full copy of the original. The file is only ever read.
CONVERTER_STORE=ftp

# For "disk" only: the folder the FTP site serves, WITHOUT the site's own folder on the end. The
# archive supplies that part itself (FtpSites.FtpServerFolder, normally "DOI") and it is appended, so
# both ways of reaching a file derive the path identically.
# Files at F:\Archive_papyrus\Data\FTP\DOI\2026\07\... mean CONVERTER_STORE_ROOT=F:\Archive_papyrus\Data\FTP
CONVERTER_STORE_ROOT=

# --- FTP --------------------------------------------------------------------------------------
# Only used when CONVERTER_STORE=ftp.
# Seconds for the connect, and for every command afterwards. The old pipeline set neither, inherited
# a 100 second default and lost 4382 contents to listings that never came back.
CONVERTER_FTP_CONNECT_TIMEOUT=10
CONVERTER_FTP_TIMEOUT=30

# Seconds one upload or download may take. Raise it if the archive holds very large PDFs.
CONVERTER_FTP_TRANSFER_TIMEOUT=300

# Attempts per FTP operation and the seconds waited between them.
CONVERTER_FTP_ATTEMPTS=3
CONVERTER_FTP_RETRY_SECONDS=5

# --- Pacing -----------------------------------------------------------------------------------
# Contents the dispatcher keeps queued per worker. Small on purpose: a Stop then leaves almost no
# backlog of claimed work behind.
CONVERTER_QUEUED_PER_WORKER=2

# Seconds the dispatcher waits before asking for work again when the queue is empty, and the longest
# it waits after repeated empty answers.
CONVERTER_IDLE_SECONDS=5
CONVERTER_MAX_IDLE_SECONDS=60

# --- Rarely changed ---------------------------------------------------------------------------
# Uncomment only with a reason. The value shown is the default that applies when the key is absent.

# Seconds a query on the archive may run before the driver cancels it. 0 means no limit, which is
# what you want: a discovery pass over 93 million GeneralContent rows can take minutes, and a
# cancelled pass fails without moving the watermark, so the queue would simply stop filling.
# CONVERTER_QUERY_TIMEOUT=0

# The connection in config/database.php the archive is read through, and its client charset.
# ARCHIVE_CONNECTION=archive
# ARCHIVE_DB_CHARSET=utf8

# Where the conversion jobs are queued. The connection defaults to QUEUE_CONNECTION; the name is what
# `queue:work --queue=` must be given, and the supervisor passes it on its own.
# CONVERTER_QUEUE_CONNECTION=database
# CONVERTER_QUEUE=conversions

# MVDContent.Format written for a page image. It decides the file extension on FTP, so it has to
# agree with what CONVERTER_PDF2IMG_ARGS actually produces.
# CONVERTER_IMAGE_FORMAT=Image/jpg

# The size and quality of the ThumbLayer thumbnails. 120x160 is what the archive's viewer lays its
# grid out for, and existing thumbnails are not re-generated if you change it.
# CONVERTER_THUMBNAIL_WIDTH=120
# CONVERTER_THUMBNAIL_HEIGHT=160
# CONVERTER_THUMBNAIL_QUALITY=82

# Seconds before the queue hands a job to a second worker. Ten years, i.e. never: a conversion may
# run for a long time, and putting conversions back is the reconciler's job, not the queue's.
# DB_QUEUE_RETRY_AFTER=315360000
